# IP Architect — variables d'environnement (toutes optionnelles). Copiez ce fichier en .env.local pour le développement.

# Emplacement de la base SQLite (défaut : ./data/ip-architect.db)
# DATABASE_PATH=/var/lib/ip-architect/ip-architect.db

# --- Premier démarrage et sécurité ---
# Code exigé pour créer le premier compte administrateur (en production, généré et affiché au démarrage si absent)
# IP_ARCHITECT_SETUP_CODE=changez-moi
# IP_ARCHITECT_REQUIRE_SETUP_CODE=1        # 0 pour désactiver l'exigence du code

# À activer UNIQUEMENT derrière un reverse proxy (Nginx, Apache, Traefik…) qui écrase X-Forwarded-For / -Proto
# IP_ARCHITECT_TRUST_PROXY=1
# Cookies « Secure » (site servi en HTTPS)
# IP_ARCHITECT_SECURE_COOKIES=1
# HSTS (HTTPS uniquement) et Content-Security-Policy
# IP_ARCHITECT_HSTS=1
# IP_ARCHITECT_CSP=0                        # 0 pour désactiver la CSP en cas de problème d'affichage

# --- Réseau ---
# Autorise le scan et la découverte sur des adresses publiques (déconseillé : seulement les réseaux privés par défaut)
# IP_ARCHITECT_SCAN_PUBLIC=1
